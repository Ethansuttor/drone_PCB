+// Snapshot everything about the bus that does not depend on a device answering.
+// Called after spiSetBusInstance() succeeds, so spiDevice[] is whatever
+// spiPinConfigure() left it as at boot.
+static void flashProbeSnapshotBus(const flashConfig_t *flashConfig)
+{
+    const SPIDevice spiDev = SPI_CFG_TO_DEV(flashConfig->spiDevice);
+
+    if (spiDev == SPIINVALID) {
+        return;
+    }
+
+    ioTag_t sck = IO_TAG_NONE, miso = IO_TAG_NONE, mosi = IO_TAG_NONE;
+    spiGetResolvedPins(spiDev, &sck, &miso, &mosi);
+    flashProbeDebug.pinSck = sck;
+    flashProbeDebug.pinMiso = miso;
+    flashProbeDebug.pinMosi = mosi;
+
+    SPI_TypeDef *reg = spiInstanceByDevice(spiDev);
+    flashProbeDebug.spiRegBase = (uint32_t)reg;
+
+    if (reg) {
+        flashProbeDebug.cr1 = reg->CR1;
+        flashProbeDebug.cr2 = reg->CR2;
+        flashProbeDebug.sr = reg->SR;
+    }
+
+    // Decode the MISO pin directly out of GPIO. If MODER is not 2 (alternate
+    // function) or the AF nibble is not 5, SPI2 is not connected to the pin no
+    // matter how healthy the pin and the net measure.
+    const IO_t misoIo = IOGetByTag(miso);
+    if (misoIo) {
+        GPIO_TypeDef *gpio = IO_GPIO(misoIo);
+        const int pinIdx = IO_GPIOPinIdx(misoIo);
+        if (gpio && (pinIdx >= 0)) {
+            flashProbeDebug.misoModer = (gpio->MODER >> (pinIdx * 2)) & 0x3;
+            flashProbeDebug.misoAf = (gpio->AFR[pinIdx >> 3] >> ((pinIdx & 7) * 4)) & 0xf;
+        }
+    }
+}
+#endif // USE_FLASH_DEBUG_PROBE
