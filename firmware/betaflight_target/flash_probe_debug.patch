diff --git a/src/main/drivers/flash.h b/src/main/drivers/flash.h
index da75304bb..02bfc9874 100644
--- a/src/main/drivers/flash.h
+++ b/src/main/drivers/flash.h
@@ -110,3 +110,57 @@ flashPartition_t *flashPartitionFindByType(flashPartitionType_e type);
 const flashPartition_t *flashPartitionFindByIndex(uint8_t index);
 const char *flashPartitionGetTypeName(flashPartitionType_e type);
 int flashPartitionCount(void);
+
+#if defined(USE_FLASH_DEBUG_PROBE) && defined(USE_FLASH_SPI)
+/*
+ * ETHANF405 blackbox-flash bring-up instrumentation.
+ *
+ * flashSpiInit() has three silent `return false` exits and no logging, so a
+ * probe that bailed before touching the bus is indistinguishable from one that
+ * transacted and clocked in zeros. flash_info prints geometry cached from boot
+ * and re-probes nothing, so it cannot tell them apart either.
+ *
+ * This records which exit was taken, what spiPinConfigure() resolved for the
+ * bus, the SPI peripheral and MISO pin register state, and the raw RDID bytes.
+ */
+typedef enum {
+    FLASH_PROBE_NOT_RUN = 0,        // flashSpiInit() was never entered
+    FLASH_PROBE_NO_CS_TAG,          // flashConfig->csTag == 0
+    FLASH_PROBE_CS_NOT_FREE,        // IOIsFreeOrPreinit(CS) false, another owner holds it
+    FLASH_PROBE_NO_BUS_INSTANCE,    // spiSetBusInstance() false, bus never pin-configured
+    FLASH_PROBE_TRANSACTED,         // a transfer was actually issued onto the bus
+    FLASH_PROBE_STAGE_COUNT
+} flashProbeStage_e;
+
+typedef struct flashProbeDebug_s {
+    uint8_t  stage;             // flashProbeStage_e, how far flashSpiInit() got
+    uint8_t  isReprobe;         // 0 = record left by boot, 1 = by "flash_info probe"
+
+    uint8_t  csTag;             // flashConfig->csTag
+    uint8_t  spiDeviceCfg;      // flashConfig->spiDevice, 1-based, 0 = none
+    int8_t   spiDeviceIdx;      // SPI_CFG_TO_DEV(), 0-based, -1 = SPIINVALID
+
+    uint8_t  csOwner;           // resourceOwner_e holding the CS pin at probe time
+    uint8_t  csFreeOrPreinit;
+
+    uint8_t  pinSck;            // what spiPinConfigure() matched for this bus
+    uint8_t  pinMiso;
+    uint8_t  pinMosi;
+    uint32_t spiRegBase;        // spiInstanceByDevice(), 0 = bus never configured
+
+    uint32_t cr1;               // SPI peripheral state at probe time
+    uint32_t cr2;
+    uint32_t sr;
+    uint8_t  misoModer;         // MODER field for the MISO pin, 2 = alternate function
+    uint8_t  misoAf;            // AFR nibble for the MISO pin, 5 = SPI2 on F4
+
+    uint8_t  readIssued;        // spiReadRegBufRB() returned true
+    uint8_t  rawId[4];          // raw RDID bytes off the wire
+} flashProbeDebug_t;
+
+extern flashProbeDebug_t flashProbeDebug;
+
+// Re-run the SPI probe from the CLI and refresh flashProbeDebug. Returns true
+// if a chip was identified, in which case geometry and partitions are updated.
+bool flashReprobe(void);
+#endif // USE_FLASH_DEBUG_PROBE && USE_FLASH_SPI
